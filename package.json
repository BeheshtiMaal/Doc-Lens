{
  "name": "doclens",
  "version": "0.1.0",
  "private": true,
  "description": "Your documents. Grounded answers.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/run-tool.mjs next dev",
    "build": "node scripts/run-tool.mjs next build",
    "start": "node scripts/run-tool.mjs next start",
    "lint": "eslint .",
    "typecheck": "node scripts/run-tool.mjs next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:browser": "node scripts/run-tool.mjs playwright test",
    "db:local": "tsx scripts/db-local.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:sweep": "tsx scripts/db-sweep.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.61",
    "@ai-sdk/openai": "4.0.73",
    "@ai-sdk/react": "4.0.115",
    "@langchain/anthropic": "1.5.11",
    "@langchain/core": "1.2.12",
    "@langchain/openai": "1.5.13",
    "@langchain/textsplitters": "1.0.1",
    "@next/env": "16.3.6",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "ai": "7.0.112",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "generative-loaders": "0.1.1",
    "langchain": "1.5.12",
    "lucide-react": "1.47.0",
    "mammoth": "1.12.3",
    "motion": "13.4.2",
    "nanoid": "6.0.1",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "pgvector": "0.3.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "streamdown": "2.6.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "word-extractor": "1.0.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
