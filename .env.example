# Copy to .env.local. Never commit provider keys or real database credentials.
# This URL matches compose.yaml (local development only).
DATABASE_URL=postgresql://doclens:doclens_local@127.0.0.1:5432/doclens

# Use an AvalAI API key for embeddings and OpenAI-compatible chat; never expose it in the browser.
DOCLENS_AVALAI_API_KEY=
# Legacy fallback when DOCLENS_AVALAI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.avalai.ir/v1
# Required in production for the scheduled workspace cleanup endpoint; use 16+ random characters.
CRON_SECRET=

APP_ORIGIN=http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
WORKSPACE_IDLE_TTL_SECONDS=1800
WORKSPACE_CLOSE_GRACE_SECONDS=120
